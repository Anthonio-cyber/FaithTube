# FaithTube configuration.
#
# Everything below is optional except DATABASE_URL and JWT_SECRET in production.
# When an integration is not configured the platform does not pretend it works:
# the affected control shows a clear "not configured" state, and the admin
# dashboard lists exactly what is on and off.

# ─── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# In single-service mode (SERVE_WEB=true) these are the same public URL.
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# Serve the built web client from the API — one process, one domain, no CORS.
# Set to true for hosted deployments.
SERVE_WEB=false
WEB_DIST_DIR=../web/dist

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite for local development; Postgres for anything hosted, because free hosts
# have ephemeral disks. The provider is inferred from the URL scheme, or set
# DATABASE_PROVIDER explicitly.
DATABASE_URL="file:./prisma/dev.db"
# DATABASE_URL="postgresql://user:password@host/faithtube?sslmode=require"
# DATABASE_PROVIDER=postgresql

# ─── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# The server refuses to start in production while this is the default value.
JWT_SECRET=dev-only-insecure-secret-change-me
SESSION_TTL_DAYS=30
COOKIE_SECURE=false          # must be true when served over HTTPS
# "lax" suits a same-origin deployment. A client on a different domain — a
# Vercel-hosted front end talking to an API elsewhere — needs "none", which
# browsers only honour together with COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.org
# Browser origins allowed to call the API, comma separated. Not needed when the
# API serves the client itself (SERVE_WEB=true).
# CORS_EXTRA_ORIGINS=https://faithtube.vercel.app
RATE_LIMIT_ENABLED=true

# ─── Sign in with Google ───────────────────────────────────────────────────────
# Create an OAuth 2.0 Web client in Google Cloud Console. The redirect URI must
# match exactly. Without these, email sign-in still works normally.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-domain.example/auth/google/callback

# ─── Storage ───────────────────────────────────────────────────────────────────
# local: files on disk (development, or a host with a persistent volume)
# s3:    any S3-compatible service. Cloudflare R2's free tier is a good fit and
#        charges nothing for egress, which matters a great deal for video.
# db:    media rows in Postgres. For a host with neither a durable disk nor a
#        bucket — chosen automatically there, because "local" would mean every
#        upload disappearing at the next restart. Capped per file; move to s3.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
# Ceiling for one file under STORAGE_DRIVER=db. A database is not a media store
# and a free Postgres tier is often half a gigabyte in total.
# DB_STORAGE_MAX_BYTES=50331648
STORAGE_PUBLIC_BASE=/media
MAX_UPLOAD_BYTES=2147483648

# S3_BUCKET=faithtube-media
# S3_REGION=auto                                   # "auto" for Cloudflare R2
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CDN_BASE_URL=https://media.your-domain.example   # public bucket or CDN origin

# With object storage configured, the browser uploads video straight to the
# bucket using a signed URL, so the file never passes through the API. This is
# how long that URL stays valid — it has to outlast a slow upload.
# UPLOAD_URL_TTL_SECONDS=21600
#
# The bucket needs a CORS policy allowing PUT from your site's origin, or the
# browser will refuse the upload. See VERCEL.md for the exact policy.

# ─── Video processing ──────────────────────────────────────────────────────────
# ffmpeg enables generated thumbnails, audio extraction and the quality ladder.
# Without it the platform serves uploads exactly as received.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TRANSCODE_ENABLED=true
WORKER_ENABLED=true
WORKER_POLL_MS=1500
# Drains the job queue in the request that filled it, instead of leaving it to
# the background worker. Set automatically on serverless hosts, which have no
# process to poll and no schedule frequent enough to stand in for one.
# INLINE_PIPELINE=false
# Only for hosts that cannot keep a process alive. Set a secret and call
# /api/system/cron/process on a schedule to drive the queue instead.
# CRON_SECRET=
# CRON_MAX_JOBS=3

# ─── AI moderation ─────────────────────────────────────────────────────────────
# auto      — Claude when a key is present, otherwise the on-device classifier
# heuristic — always the on-device classifier (fully functional, no key needed)
# anthropic — always Claude
MODERATION_PROVIDER=auto
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Transcription ─────────────────────────────────────────────────────────────
# Any Whisper-compatible HTTP endpoint. Without one, the classifier is told that
# speech evidence is missing rather than being given an invented transcript.
TRANSCRIPTION_PROVIDER=auto
# WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
# WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# ─── Payments ──────────────────────────────────────────────────────────────────
# Card details never reach this application; Stripe Checkout is hosted.
# Point a Stripe webhook at POST /api/premium/webhook.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# ─── Live streaming ────────────────────────────────────────────────────────────
# An RTMP ingest and HLS playback origin. Without these, streams can still be
# scheduled and chatted in, but no video can be received.
# LIVE_INGEST_BASE=rtmp://ingest.your-provider.example/live
# LIVE_PLAYBACK_BASE=https://playback.your-provider.example/hls

# ─── Seeding ───────────────────────────────────────────────────────────────────
# Change these before seeding anything you intend to expose publicly.
SEED_ADMIN_EMAIL=admin@faithtube.example
SEED_ADMIN_PASSWORD=ChangeMe!2024
# SEED_ON_BOOT=true
